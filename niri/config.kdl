// cartoon-raccoon's niri config
input {
    keyboard {
        xkb {
            // For more information, see xkeyboard-config(7).

            // For example:
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
        }

        // Enable numlock on startup, omitting this setting disables it.
        numlock
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // middle-emulation
    }

    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="0%"

    workspace-auto-back-and-forth
}

// Outputs
output "DP-1" {
    mode "3840x2160@160.001"
    scale 1.5
    transform "normal"
    position x=0 y=0
    variable-refresh-rate

    hot-corners {
        top-left
    }
}

// oooo                                                  .   
// `888                                                .o8   
//  888   .oooo.   oooo    ooo  .ooooo.  oooo  oooo  .o888oo 
//  888  `P  )88b   `88.  .8'  d88' `88b `888  `888    888   
//  888   .oP"888    `88..8'   888   888  888   888    888   
//  888  d8(  888     `888'    888   888  888   888    888 . 
// o888o `Y888""8o     .8'     `Y8bod8P'  `V88V"V8P'   "888" 
//                 .o..P'                                    
//                 `Y8P'                                      

layout {
    // Set gaps around windows in logical pixels.
    gaps 5

    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.5
        proportion 0.66667
        proportion 0.75
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.5
        proportion 0.66667
        proportion 0.75
        proportion 1.0
    }

    // Set default width of all windows to full, and have window rules catch exceptions.
    default-column-width { proportion 0.5; }

    // You can change how the focus ring looks.
    focus-ring {
        off

        // How many logical pixels the ring extends out from the windows.
        width 2

        // Color of the ring on the active monitor.
        active-color "#7fc8ff"

        // Color of the ring on inactive monitors.
        inactive-color "#505050"

        active-gradient from="#a9c8fd" to="#0a305d" angle=45

        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    border {
        // off

        width 2
        active-color "#a9c8fd"
        inactive-color "#505050"

        // Color of the border around windows that request your attention.
        urgent-color "#9b0000"

        active-gradient from="#a9c8fd" to="#0a305d" angle=135 relative-to="workspace-view"

        inactive-gradient from="#505050" to="#808080" angle=135 relative-to="workspace-view"
    }

    shadow {
        // on

        // By default, the shadow draws only around its window, and not behind it.
        // Uncomment this setting to make the shadow draw behind its window.
        //
        // Note that niri has no way of knowing about the CSD window corner
        // radius. It has to assume that windows have square corners, leading to
        // shadow artifacts inside the CSD rounded corners. This setting fixes
        // those artifacts.
        // 
        // However, instead you may want to set prefer-no-csd and/or
        // geometry-corner-radius. Then, niri will know the corner radius and
        // draw the shadow correctly, without having to draw it behind the
        // window. These will also remove client-side shadows if the window
        // draws any.
        // 
        // draw-behind-window true

        // Softness controls the shadow blur radius.
        softness 30

        // Spread expands the shadow.
        spread 5

        // Offset moves the shadow relative to the window.
        offset x=0 y=5

        // You can also change the shadow color and opacity.
        color "#0007"
    }

    tab-indicator {
        on
    }

    struts {
        top 4
        bottom 4
        left 8
        right 8
    }
}

prefer-no-csd

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

//                        o8o                             
//                        `"'                             
//  .oooo.   ooo. .oo.   oooo  ooo. .oo.  .oo.    .oooo.o 
// `P  )88b  `888P"Y88b  `888  `888P"Y88bP"Y88b  d88(  "8 
//  .oP"888   888   888   888   888   888   888  `"Y88b.  
// d8(  888   888   888   888   888   888   888  o.  )88b 
// `Y888""8o o888o o888o o888o o888o o888o o888o 8""888P' 

// Animation settings.
animations {
    // Uncomment to turn off all animations.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0
}

//                  oooo                                      
//                  `888                                      
// oooo oooo    ooo  888  oooo   .oooo.o oo.ooooo.   .ooooo.  
//  `88. `88.  .8'   888 .8P'   d88(  "8  888' `88b d88' `"Y8 
//   `88..]88..8'    888888.    `"Y88b.   888   888 888       
//    `888'`888'     888 `88b.  o.  )88b  888   888 888   .o8 
//     `8'  `8'     o888o o888o 8""888P'  888bod8P' `Y8bod8P' 
//                                        888                 
//                                       o888o                 

/*
The workspace model is as follows.

The static named workspaces are:

- Main (idx 1): This usually contains the browser and any other windows currently being used.
- Dev (idx 2): This contains the development environment and any other development tools.
- Social (idx 3): This contains social apps such as Discord or Element.
- Music (idx 4): This contains music apps such as Spotify and ncmpcpp will go.

Anything below this (idx 5 onwards) is a dynamic unnamed workspace. These are where all other windows go.

The keybinds that correspond to the workspace are:

A: Main
S: Dev
D: Social
F: Music
Backspace: The first dynamic workspace.

*/

workspace "Main" {
    open-on-output "DP-1"

    layout {
        default-column-display "tabbed"

        tab-indicator {
            hide-when-single-tab
        }
    }
}

workspace "Dev" {
    open-on-output "DP-1"

    layout {
        default-column-display "tabbed"

        tab-indicator {
            hide-when-single-tab
        }
    }
}

workspace "Social" {
    open-on-output "DP-1"

    layout {
        default-column-display "tabbed"

        tab-indicator {
            hide-when-single-tab
        }
    }
}

workspace "Music" {
    open-on-output "DP-1"

    layout {
        default-column-display "tabbed"

        tab-indicator {
            hide-when-single-tab
        }
    }
}

//  .ooooo.  oooo    ooo  .ooooo.   .ooooo.   .oooo.o 
// d88' `88b  `88b..8P'  d88' `88b d88' `"Y8 d88(  "8 
// 888ooo888    Y888'    888ooo888 888       `"Y88b.  
// 888    .o  .o8"'88b   888    .o 888   .o8 o.  )88b 
// `Y8bod8P' o88'   888o `Y8bod8P' `Y8bod8P' 8""888P'  

spawn-at-startup "udiskie"

spawn-at-startup "easyeffects"

spawn-at-startup "spotify-launcher"

spawn-at-startup "discord"

spawn-at-startup "code"

spawn-at-startup "zen-browser"

//                   o8o                                   oooo                     
//                   `"'                                   `888                     
// oooo oooo    ooo oooo  ooo. .oo.   oooo d8b oooo  oooo   888   .ooooo.   .oooo.o 
//  `88. `88.  .8'  `888  `888P"Y88b  `888""8P `888  `888   888  d88' `88b d88(  "8 
//   `88..]88..8'    888   888   888   888      888   888   888  888ooo888 `"Y88b.  
//    `888'`888'     888   888   888   888      888   888   888  888    .o o.  )88b 
//     `8'  `8'     o888o o888o o888o d888b     `V88V"V8P' o888o `Y8bod8P' 8""888P' 

// Floating window rules
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    match app-id=r#"blender"# title=r#"^Blender Preferences$"#
    
    // all non-toplevel steam windows
    match app-id=r#"^steam$"#
    exclude app-id=r#"^steam$"# title=r#"^Steam$"#

    match app-id=r#"^blueman-manager$"#

    match app-id=r#"^org.telegram.desktop$"# title=r#"^Media viewer$"#

    match app-id=r#"^nemo$"# title=r#".* Properties"#

    open-floating true
}

// rules for "system" windows
window-rule {
    match app-id=r#"^dev.noctalia.Noctalia$"#
    match app-id=r#"^org.corectrl.CoreCtrl$"#
    match app-id=r#"^com.github.wwmm.easyeffects$"# title=r#"Easy Effects"#
    match app-id=r#"^io.github.ilya_zlobintsev.LACT$"#

    default-column-width { fixed 1700; }
    default-window-height { fixed 1200; }

    open-floating true
}

// floating and size rule for wev
window-rule {
    match app-id=r#"wev"#

    default-column-width { fixed 500; }
    default-window-height { fixed 500; }

    open-floating true
}

// Alacritty-specific rules
window-rule {
    match app-id=r#"^Alacritty$"#

    default-column-width { proportion 0.5; }
}

// rule for splash screens
window-rule {
    // match on ^FreeCAD$, since main window has version (e.g. FreeCAD 1.1.x)
    match app-id=r#"org.freecad.FreeCAD"# title=r#"^FreeCAD$"#

    open-floating true

    border {
        off
    }

    shadow {
        off
    }

    background-effect {
        xray true
        blur false
    }
}

// steam windows sometimes undraw their contents before they actually delete the window,
// which means the border gets shown as a solid rectangle momentarily before the window
// disappears. this rule forces the border to be drawn as a border.
window-rule {
    match app-id=r#"^steam$"#
    exclude app-id=r#"^steam$"# title=r#"^Steam$"#

    draw-border-with-background false
}

// window rule for blacking out certain things from screen capture.
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    match app-id=r#"^app\.drey\.KeyRack$"#
    match app-id=r#"^Bitwarden$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Rules for opening windows on workspaces 

window-rule {
    match app-id=r#"^zen$"# at-startup=true

    open-on-workspace "Main"
}

window-rule {
    match app-id=r#"^com.microsoft.VSCode$"#

    open-on-workspace "Dev"
}

window-rule {
    match app-id=r#"^discord$"#
    match app-id=r#"^Element$"#

    // todo: uncomment once the next release of niri is out
    //on-xdg-activate "focus"
    open-on-workspace "Social"
}

window-rule {
    match app-id=r#"^spotify$"#

    open-on-workspace "Music"
}

// catch-all rule: non-terminal or non-floating windows should open maximized
window-rule {
    exclude app-id=r#"^Alacritty$"#
    exclude app-id=r#"^Bitwarden$"#
    exclude app-id=r#"^app.drey.KeyRack$"#
    exclude is-floating=true

    open-maximized true
}

// Round all window corners.
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    open-maximized-to-edges false
}

// oooo                               .o8        o8o                    .o8  
// `888                              "888        `"'                   "888  
//  888  oooo   .ooooo.  oooo    ooo  888oooo.  oooo  ooo. .oo.    .oooo888   .oooo.o 
//  888 .8P'   d88' `88b  `88.  .8'   d88' `88b `888  `888P"Y88b  d88' `888  d88(  "8 
//  888888.    888ooo888   `88..8'    888   888  888   888   888  888   888  `"Y88b.  
//  888 `88b.  888    .o    `888'     888   888  888   888   888  888   888  o.  )88b 
// o888o o888o `Y8bod8P'     .8'      `Y8bod8P' o888o o888o o888o `Y8bod88P" 8""888P' 
//                       .o..P'                                                       
//                       `Y8P'          

binds {

//                                               '||` 
//                                                ||  
//  .|''|, .|''|, `||''|,  .|''|, '||''|  '''|.   ||  
//  ||  || ||..||  ||  ||  ||..||  ||    .|''||   ||  
//  `|..|| `|...  .||  ||. `|...  .||.   `|..||. .||. 
//      ||                                            
//   `..|'     

    // Mod-Shift-/, which is usually the same as Mod-?,
    // shows a list of important hotkeys.
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Binds for running programs.
    Mod+grave hotkey-overlay-title="Open a terminal" \
        { spawn "alacritty"; }
    Mod+R hotkey-overlay-title="Open the launcher" \
        { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Shift+R hotkey-overlay-title="Run a command" \
        { spawn "noctalia" "msg" "panel-toggle" "nocode-96/cmd-runner:panel"; }
    Mod+Ctrl+L hotkey-overlay-title="Lock the Screen" \
        { spawn "noctalia" "msg" "session" "lock"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Open the session menu" \
        { spawn "noctalia" "msg" "panel-toggle" "session";}

    // Media control binds.
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume up" \
        { spawn "noctalia" "msg" "volume-up" "5"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume down" \
        { spawn "noctalia" "msg" "volume-down" "5"; }
    XF86AudioMute        allow-when-locked=true hotkey-overlay-title="Mute" \
        { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true hotkey-overlay-title="Mute microphone"\
        { spawn "noctalia" "msg" "mic-mute"; }
    
    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }

    // Open/close the Overview: a zoomed-out view of workspaces and windows.
    // You can also move the mouse into the top-left hot corner,
    // or do a four-finger swipe up on a touchpad.
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    // Actions to switch keyboard layouts.
    // Note: if you uncomment these, make sure you do NOT have
    // a matching layout switch hotkey configured in xkb options above.
    // Having both at once on the same hotkey will break the switching,
    // since it will switch twice upon pressing the hotkey (once by xkb, once by niri).
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    // Binds to kill uncooperative windows, adding modifiers with increasing escalation.
    
    // SHIFT only sends SIGINT.
    Mod+Shift+K      { spawn-sh "~/.config/niri/niri-kill.sh -i"; }
    // CTRL only sends SIGTERM.
    Mod+Ctrl+K       { spawn-sh "~/.config/niri/niri-kill.sh -t"; }
    // SHIFT+CTRL sends SIGKILL.
    Mod+Shift+Ctrl+K { spawn-sh "~/.config/niri/niri-kill.sh -k"; }

    Print { screenshot; }
    Mod+Print { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }

    // Applications such as remote-desktop clients and software KVM switches may
    // request that niri stops processing the keyboard shortcuts defined here
    // so they may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor,
    // so a buggy application can't hold your session hostage.
    //
    // The allow-inhibiting=false property can be applied to other binds as well,
    // which ensures niri always processes them, even when an inhibitor is active.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Ctrl+Q hotkey-overlay-title="Exit to login screen" { quit; }

//                          '||                                         
//                           ||                                         
// '\\    //` .|''|, '||''|  || //`  ('''' '||''|,  '''|.  .|'', .|''|, 
//   \\/\//   ||  ||  ||     ||<<     `'')  ||  || .|''||  ||    ||..|| 
//    \/\/    `|..|' .||.   .|| \\.  `...'  ||..|' `|..||. `|..' `|...  
//                                          ||                          
//                                         .||                          

    /*
    The general model for window management is: default granularity in the X axis
    is a column, default granularity in the Y axis is a workspace; the default action
    is to change focus, Adding modifiers changes the action to a move, with the granularity
    depending on the modifier used.

    Shift: Uses column-in-workspace granularity. up/down moves columns between workspaces,
    left/right shuffles columns within a workspace.

    Ctrl: Uses workspace-in-monitor granularity. up/down shuffles workspaces, left/right
    moves workspaces between monitors.

    Alt: Uses individual window granularity. up/down shuffles windows within a column
    */

    // Switches focus between the current and the previous workspace.
    Mod+Tab { focus-workspace-previous; }

    Mod+Delete { spawn-sh "~/.config/niri/name-workspace.sh unset"; }
    Mod+Slash  { spawn-sh "~/.config/niri/name-workspace.sh set"; }

    // Focus-changing keybinds, default granularity.
    Mod+WheelScrollUp         { focus-workspace-up; }
    Mod+WheelScrollDown       { focus-workspace-down; }
    Mod+Shift+WheelScrollUp   { focus-column-left-or-last; }
    Mod+Shift+WheelScrollDown { focus-column-right-or-first; }

    Mod+Up    { focus-workspace-up; }
    Mod+Down  { focus-workspace-down; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }

    Mod+WheelScrollLeft  { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }

    Mod+MouseForward { focus-workspace-up; }

    // Adding Alt to the scroll gives us window-level granularity.
    Super+Alt+WheelScrollUp    { focus-window-up-or-column-left; }
    Super+Alt+WheelScrollDown  { focus-window-down-or-column-right; }
    // These bindings are for DuckyPad support.
    Super+Shift+Alt+Up         { focus-window-up-or-column-left; }
    Super+Shift+Alt+Down       { focus-window-down-or-column-right; }

    Mod+Return { focus-workspace "Main"; }
    Mod+A      { focus-workspace "Main"; }
    Mod+S      { focus-workspace "Dev"; }
    Mod+D      { focus-workspace "Social"; }
    Mod+F      { focus-workspace "Music"; }

    // Backspace corresponds to the first dynamic workspace.
    Mod+Backspace { focus-workspace 5; }
    Mod+Backslash { spawn-sh "~/.config/niri/lastwkspc.sh focus"; }

    Mod+1 { focus-workspace 5; }
    Mod+2 { focus-workspace 6; }
    Mod+3 { focus-workspace 7; }
    Mod+4 { focus-workspace 8; }
    Mod+5 { focus-workspace 9; }

    // No modifiers: focus control

    Mod+Page_Up   { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }

    Mod+BracketLeft  { focus-column-first; }
    Mod+BracketRight { focus-column-last; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // With ALT: move by window
    Super+Alt+Up    { move-window-up; }
    Super+Alt+Down  { move-window-down; }
    Super+Alt+Left  { consume-or-expel-window-left; }
    Super+Alt+Right { consume-or-expel-window-right; }

    Super+Alt+Backspace { move-window-to-workspace 5; }
    Super+Alt+Backslash { spawn-sh "~/.config/niri/lastwkspc.sh movewin"; }

    Super+Alt+1 { move-window-to-workspace 5; }
    Super+Alt+2 { move-window-to-workspace 6; }
    Super+Alt+3 { move-window-to-workspace 7; }
    Super+Alt+4 { move-window-to-workspace 8; }
    Super+Alt+5 { move-window-to-workspace 9; }

    // Keybinds to move the focused window to the first or last dynamic workspace.
    Super+Alt+Ctrl+Backspace { move-window-to-workspace 5 focus=false; }
    Super+Alt+Ctrl+Backslash { spawn-sh "~/.config/niri/lastwkspc.sh movewin -nf"; }

    // With SHIFT/CTRL: move by column, CTRL moves without changing focus
    Mod+Shift+Up    { move-column-to-workspace-up; }
    Mod+Shift+Down  { move-column-to-workspace-down; }
    Mod+Ctrl+Up     { move-column-to-workspace-up focus=false; }
    Mod+Ctrl+Down   { move-column-to-workspace-down focus=false; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // Shift+WheelScroll is used to change focus by column, so cannot be used for up/down here.
    Mod+Shift+MouseForward { move-column-to-workspace-up; }
    Mod+Shift+MouseBack    { move-column-to-workspace-down; }

    Mod+Ctrl+MouseForward { move-column-to-workspace-up focus=false; }
    Mod+Ctrl+MouseBack    { move-column-to-workspace-down focus=false; }

    Mod+Shift+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollRight { move-column-right; }

    Mod+Shift+Return { move-column-to-workspace "Main"; }
    Mod+Shift+A      { move-column-to-workspace "Main"; }
    Mod+Shift+S      { move-column-to-workspace "Dev"; }
    Mod+Shift+D      { move-column-to-workspace "Social"; }
    Mod+Shift+F      { move-column-to-workspace "Music"; }

    Mod+Shift+Backspace { move-column-to-workspace 5; }
    Mod+Shift+Backslash { spawn-sh "~/.config/niri/lastwkspc.sh movecol"; }

    Mod+Ctrl+Return { move-column-to-workspace "Main" focus=false; }
    Mod+Ctrl+A      { move-column-to-workspace "Main" focus=false; }
    Mod+Ctrl+S      { move-column-to-workspace "Dev" focus=false; }
    Mod+Ctrl+D      { move-column-to-workspace "Social" focus=false; }
    Mod+Ctrl+F      { move-column-to-workspace "Music" focus=false; }

    Mod+Ctrl+Backspace { move-column-to-workspace 5 focus=false; }
    Mod+Ctrl+Backslash { spawn-sh "~/.config/niri/lastwkspc.sh movecol -nf"; }

    Mod+Shift+1 { move-column-to-workspace 5; }
    Mod+Shift+2 { move-column-to-workspace 6; }
    Mod+Shift+3 { move-column-to-workspace 7; }
    Mod+Shift+4 { move-column-to-workspace 8; }
    Mod+Shift+5 { move-column-to-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 5 focus=false; }
    Mod+Ctrl+2 { move-column-to-workspace 6 focus=false; }
    Mod+Ctrl+3 { move-column-to-workspace 7 focus=false; }
    Mod+Ctrl+4 { move-column-to-workspace 8 focus=false; }
    Mod+Ctrl+5 { move-column-to-workspace 9 focus=false; }

    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }

    Mod+Ctrl+Page_Up   { move-column-to-workspace-up focus=false; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down focus=false; }

    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // With SHIFT+CTRL: move by workspace

    Mod+Shift+Ctrl+Up    { move-workspace-up; }
    Mod+Shift+Ctrl+Down  { move-workspace-down; }
    Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-workspace-to-monitor-right; }

    Mod+Shift+Ctrl+WheelScrollUp    { move-workspace-up; }
    Mod+Shift+Ctrl+WheelScrollDown  { move-workspace-down; }
    Mod+Shift+Ctrl+WheelScrollLeft  { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+WheelScrollRight { move-workspace-to-monitor-right; }

    Mod+Shift+Ctrl+1 { move-workspace-to-index 5; }
    Mod+Shift+Ctrl+2 { move-workspace-to-index 6; }
    Mod+Shift+Ctrl+3 { move-workspace-to-index 7; }
    Mod+Shift+Ctrl+4 { move-workspace-to-index 8; }
    Mod+Shift+Ctrl+5 { move-workspace-to-index 9; }

    Mod+Shift+Ctrl+Backspace { move-workspace-to-index 5; }

//  '||`                                    ||    
//   ||                                     ||    
//   ||   '''|.  '||  ||` .|''|, '||  ||` ''||''  
//   ||  .|''||   `|..||  ||  ||  ||  ||    ||    
//  .||. `|..||.      ||  `|..|'  `|..'|.   `|..' 
//                 ,  |'                          
//                  ''                            

    // Consume one window from the right to the bottom of the focused column.
    Mod+Comma  { consume-window-into-column; }
    // Expel the bottom window from the focused column to the right.
    Mod+Period { expel-window-from-column; }

    Mod+E { switch-preset-column-width; }
    Mod+Shift+E { switch-preset-window-height; }
    Mod+Ctrl+E { reset-window-height; }

    Mod+M { maximize-column; }
    Mod+Shift+M { fullscreen-window; }

    // Expand the focused column to space not taken up by other fully visible columns.
    // Makes the column "fill the rest of the space".
    Mod+Ctrl+M { expand-column-to-available-width; }

    Mod+C { center-column; }

    // Center all fully visible columns on screen.
    Mod+Ctrl+C { center-visible-columns; }

    // Finer width adjustments
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Finer height adjustments when in column with other windows.
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Mod+H { move-floating-window x="-10"; }

    // Move the focused window between the floating and the tiling layout.
    Mod+T       { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }

    // Toggle tabbed column display mode.
    // Windows in this column will appear as vertical tabs,
    // rather than stacked on top of each other.
    Mod+W { toggle-column-tabbed-display; }
}

recent-windows {
    // off

    debounce-ms 750

    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 8
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

environment {
    // already in /etc/niri/env, but set here for completeness.
    DUCKYPAD_UI_SCALE "1.5"
}

debug {
    // bodge for electron apps like discord to have working notifications,
    // also for noctalia notifications to work.
    honor-xdg-activation-with-invalid-serial
}